# Get a free key at https://console.groq.com/keys — no payment method required
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Get a key at https://serpapi.com — used to search LinkedIn/Internshala/
# Indeed/Naukri via site: filters instead of scraping them directly
SERPAPI_KEY=your_serpapi_key_here

# SMTP creds used to send application emails (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
